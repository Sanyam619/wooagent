# Store URL (no trailing slash). The mock store runs on http://localhost:8787
WOO_BASE_URL=http://localhost:8787

# Option A: paste a read-only REST API key (WooCommerce > Settings > Advanced > REST API)
# Option B: delete the two key lines and run `npm run connect` to get a key via the approval flow
# The values below are the mock store's built-in fake key (`npm run mock`). Replace them for a real store.
WOO_CONSUMER_KEY=ck_mock_0000000000000000000000000000000000000
WOO_CONSUMER_SECRET=cs_mock_0000000000000000000000000000000000000

# auto = Basic auth over HTTPS, OAuth 1.0a signatures over plain HTTP
WOO_AUTH_MODE=auto

# Client-side rate limiting (requests/second, burst size, parallel requests)
WOO_RATE_LIMIT_RPS=5
WOO_RATE_LIMIT_BURST=10
WOO_MAX_CONCURRENCY=4
WOO_MAX_RETRIES=4
WOO_TIMEOUT_MS=15000

# Customer emails, phones and street addresses are masked unless this is true
WOO_EXPOSE_PII=false
